[
  {
    "context": "VimControl && !menu",
    "bindings": {
      "shift-j": ["workspace::SendKeystrokes", "5 j"],
      "shift-k": ["workspace::SendKeystrokes", "5 k"],
    },
  },
  {
    "context": "Editor && vim_mode != normal",
    "bindings": {
      "k j": ["workspace::SendKeystrokes", "escape"],
    },
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      // "space f": "file_finder::Toggle",
      "space /": "workspace::NewSearch",
      // "space w": "workspace::Save",
      // "space W": "workspace::SaveAll",
      "space e": "project_panel::ToggleFocus",
      // "space o": "outline_panel::ToggleFocus",
      "space g": "git_panel::ToggleFocus",
      // "space d": "debug_panel::ToggleFocus",
      "space a": "agent::ToggleFocus",
      // "space c a": "editor::ToggleCodeActions",
      // "space t": "terminal_panel::ToggleFocus",
      // "space b": "tab_switcher::Toggle",
    },
  },
]
