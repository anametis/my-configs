// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
	// ---* UI *--------------------------------------------------
	"base_keymap": "VSCode",
 "diff_view_style": "split",
 "language_models": {
		"openai_compatible": {},
	},
	"agent_servers": {
		"codex-acp": {
   "type": "registry"
  },
  "opencode": {
			"type": "registry",
		},
	},
	"cli_default_open_behavior": "new_window",
	"icon_theme": "Symbols Icon Theme",
	"project_panel": {
		"dock": "left",
	},
	"outline_panel": {
		"dock": "left",
	},
	"collaboration_panel": {
		"dock": "left",
	},
	"git_panel": {
		"tree_view": false,
		"dock": "left",
	},
	"debugger": {
		"dock": "right",
	},
	"terminal": {
		"dock": "bottom",
		"font_family": "MesloLGS NF",
	},
	"theme": "VSCode Dark Modern",
	"ui_font_size": 16,
	"ui_font_family": "MesloLGS NF",
	"buffer_font_family": "MesloLGS NF",
	"buffer_font_size": 16,
	"buffer_line_height": { "custom": 1.7 },
	"tab_size": 4,
	"hard_tabs": true,

	// ---* EDITOR *----------------------------------------------
	"autosave": {
		"after_delay": {
			"milliseconds": 2000,
		},
	},
	"relative_line_numbers": "enabled",

	// ---* AI *--------------------------------------------------
	"agent": {
		"sidebar_side": "right",
		"tool_permissions": {
			"default": "allow",
		},
		"default_profile": "write",
		"dock": "right",
		"default_model": {
			"effort": "medium",
   "enable_thinking": true,
			"provider": "openai-subscribed",
			"model": "gpt-5.6-sol",
		},
	},
	"edit_predictions": {
		"provider": "zed",
		"mode": "eager",
		"copilot": {
			"proxy": null,
			"proxy_no_verify": null,
		},
	},

	// ---* VIM *-------------------------------------------------
	"vim_mode": true,
	// "base_keymap": "",

	// ---* GIT *-------------------------------------------------

	// ---* LINTER + FORMATER *-----------------------------------
	"languages": {
		"GraphQL": {
			"formatter": "prettier",
		},
		"JSON": {
			"formatter": "prettier",
		},
		"JSONC": {
			"formatter": "prettier",
		},
		"HTML": {
			"formatter": "prettier",
		},
		"CSS": {
			"formatter": "prettier",
		},
		"JavaScript": {
			"formatter": "prettier",
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
			},
		},
		"TypeScript": {
			"formatter": "prettier",
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
			},
		},
		"TSX": {
			"formatter": "prettier",
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
			},
		},
		"Svelte": {
			"formatter": "prettier",
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
			},
		},
		"Vue.js": {
			"formatter": "prettier",
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
			},
		},
		"Astro": {
			"formatter": "prettier",
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
			},
		},
	},
	"format_on_save": "on",
}
